{
  "name": "patently-alive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sim.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "node scripts/data/fetch.mjs",
    "data:check": "node scripts/data/check-traits.mjs",
    "data:fit": "node scripts/data/fit-scaling.mjs",
    "sweep": "vitest run --config vitest.sweep.config.ts --silent=false scripts/sweep.bench.ts",
    "routes": "vitest run --config vitest.sweep.config.ts --silent=false scripts/routes.bench.ts"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
